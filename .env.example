# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_RELAY_BASE: Public URL of the NexaGo Remote signaling relay
# (server/relay.mjs). When set (e.g. https://thanexsago.com),
# the admin UI creates real remote sessions against that relay instead of the
# local relay on port 3100. Leave empty to keep using the current origin / local relay.
VITE_RELAY_BASE=""

# Optional Supabase persistence (recommended for production).
# When set, store + security payloads are mirrored to Supabase PostgreSQL
# (tables: nexago_stores, nexago_security — run supabase/schema.sql once).
# The service_role key is used ONLY server-side inside server/relay.mjs; it is
# never sent to browsers. Set these in DigitalOcean Environment Variables.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Frontend Supabase config (VITE_* are inlined at build time by Vite).
# Needed to show the Google account chooser for "Continue with Google" login.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional relay security hardening.
# Use a long random value (32+ chars). When set, security users/sessions/audit
# and uploaded secure files are encrypted at rest with AES-256-GCM.
NEXAGO_DATA_ENCRYPTION_KEY=""

# Optional strict mode. Keep 0 while migrating old role apps. Set 1 after every
# client sends session tokens or a trusted write token for state writes.
NEXAGO_STRICT_SECURITY="0"
NEXAGO_STATE_WRITE_TOKEN=""

# Optional trusted automation token for Super Admin development / AI agents.
# Requests with header X-Nexago-Agent: this-value bypass dev-safe rate locks.
NEXAGO_AGENT_TOKEN=""

# Optional instant security alerts. Webhook receives JSON; Telegram sends text.
NEXAGO_SECURITY_ALERT_WEBHOOK=""
NEXAGO_TELEGRAM_BOT_TOKEN=""
NEXAGO_TELEGRAM_CHAT_ID=""

# Super Admin login users are seeded from env on first login. Do not commit
# real passwords. Set these in Render Environment Variables.
NEXAGO_SUPER_ADMIN_USERS=""
NEXAGO_SUPER_ADMIN_PASSWORD=""
NEXAGO_SUPER_ADMIN_LOGIN_SECRET_CODE=""
NEXAGO_SUPER_ADMIN_PASSWORD_CHANGE_CODE=""
